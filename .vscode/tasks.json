{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Knapsack Knockout",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "javac -d out *.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$javac"
            ]
        }
    ]
}
